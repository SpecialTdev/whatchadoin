{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "checkin"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "opener:default",
    "opener:allow-open-url",
    "notification:default",
    "updater:default",
    "process:allow-restart"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whatchadoin",
  "version": "1.1.2",
  "identifier": "com.kunwo.whatchadoin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Whatchadoin",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SpecialTdev/whatchadoin/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRjc4MDk1NDcyQzE2RjIKUldUeUZpeEhsWUQzSUtBU2o1U2VBTlNWMkdqSS9DZThQdUVOTHJTSEhsaWVuZHFIbmNnOTZkdDcK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
